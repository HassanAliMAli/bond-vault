    "hono": "^4.8.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250609.0",
    "drizzle-kit": "^0.30.0",
    "typescript": "^5.8.0",
